# =============================================================================
# Deploy API — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#
# WARNING: These are local development defaults. Never use defaults in
# production. Always set strong, unique credentials in production.
# =============================================================================

# ---------------------------------------------------------------------------
# Application — API Server
# ---------------------------------------------------------------------------

# PostgreSQL connection string for job persistence.
# Format: postgres://user:password@host:port/database?sslmode=disable
# Default (local dev): postgres://deployer:secret@localhost:5432/jobs?sslmode=disable
# DATABASE_URL=postgres://deployer:secret@localhost:5432/jobs?sslmode=disable

# Redis server address for the asynq task queue.
# Default: localhost:6379
# REDIS_ADDR=localhost:6379

# HTTP port the API server listens on.
# Default: 8080
# PORT=8080

# ---------------------------------------------------------------------------
# Application — Worker
# ---------------------------------------------------------------------------

# Number of concurrent worker goroutines processing deploy jobs.
# Default: 4
# WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Deployment environment label attached to OpenTelemetry traces.
# Values: development, staging, production
# Default: development
# DEPLOY_ENV=development

# ---------------------------------------------------------------------------
# AI Judge (optional — skip if not configured)
# ---------------------------------------------------------------------------

# DeepSeek API key for AI-powered manifest verification.
# If not set, the AI judge step is skipped (heuristic-only verification runs).
# Get a key at: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Docker Compose — PostgreSQL (used by docker-compose.yml / docker/.env)
# ---------------------------------------------------------------------------

# PostgreSQL superuser credentials for the Docker Compose services.
# These are referenced by docker-compose.yml.
# POSTGRES_USER=deployer
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=jobs

# ---------------------------------------------------------------------------
# Docker Compose — Grafana
# ---------------------------------------------------------------------------

# Grafana admin password for the Docker Compose Grafana instance.
# Login URL: http://localhost:3000  (user: admin)
# GRAFANA_PASSWORD=admin
