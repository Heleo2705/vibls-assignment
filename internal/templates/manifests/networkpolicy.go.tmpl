apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{.Name}}-network-policy
  namespace: {{.Namespace}}
  labels:
    app: {{.Name}}
    managed-by: deploy-api
spec:
  podSelector:
    matchLabels:
      app: {{.Name}}
  policyTypes:
  - Ingress
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app: {{.Name}}
  - from:
    - ipBlock:
        cidr: 0.0.0.0/0
